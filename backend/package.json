{
  "name": "livestock-survey-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Livestock Survey System backend - Node.js 20 + Express + MongoDB Atlas + Redis",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test": "jest --coverage --maxWorkers=2",
    "seed": "npm run seed:locations && npm run seed:categories && npm run seed:users",
    "migrate:remove-workflow": "node scripts/migrate-remove-workflow.js",
    "seed:locations": "node scripts/seed-locations.js",
    "seed:categories": "node scripts/seed-categories.js",
    "seed:users": "node scripts/seed-users.js",
    "rebuild:summaries": "node scripts/rebuild-summaries.js",
    "clear:must-change-password": "node scripts/clear-must-change-password.js",
    "migrate:age-limits": "node scripts/migrate-age-limits.js",
    "smoke:breeding": "node scripts/smoke-breeding.js",
    "probe:queries": "node scripts/probe-queries.js",
    "test:e2e": "node scripts/e2e-journey.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.0",
    "morgan": "^1.12.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
