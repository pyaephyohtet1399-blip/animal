NODE_ENV=development
PORT=3100
MONGODB_URI=mongodb+srv://user:pass@cluster0.x.mongodb.net/livestock_survey?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
JWT_SECRET=<min 32 chars - generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
JWT_REFRESH_SECRET=<min 32 chars>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ALLOWED_ORIGINS=http://localhost:3100,https://app.example.com
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT=1mb
ID_COUNTER_RECONCILE_MINUTES=30
